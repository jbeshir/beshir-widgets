{
  "matrix": {
    "viewports": ["mobile:390x844", "tablet:768x1024", "desktop:1280x800"],
    "schemes": ["light", "dark"]
  },
  "states": [
    {
      "label": "initial",
      "steps": [],
      "expect": {"state":"ready"}
    },
    {
      "label": "design-valid",
      "steps": [
        {"click":"[data-testid=ordinary-bend]"},
        {"click":"[data-testid=swatch-ordinary-or]"},
        {"click":"[data-testid=charge-unicorn]"},
        {"click":"[data-testid=placement-ordinary]"},
        {"click":"[data-testid=count-3]"},
        {"click":"[data-testid=swatch-charge-vert]"},
        {"eval":"window.scrollTo(0, 0)"}
      ],
      "expect": {"state":"populated"}
    },
    {
      "label": "tincture-violation",
      "steps": [
        {"click":"[data-testid=swatch-field1-gules]"},
        {"click":"[data-testid=charge-lion]"},
        {"click":"[data-testid=swatch-field1-or]"},
        {"eval":"window.scrollTo(0, 0)"}
      ],
      "expect": {"state":"error"}
    },
    {
      "label": "blocked-swatch-explained",
      "steps": [
        {"click":"[data-testid=swatch-field1-gules]"},
        {"click":"[data-testid=charge-lion]"},
        {"click":"[data-testid=swatch-charge-azure]"}
      ],
      "expect": {"selector":"[data-testid=tincture-explainer]"}
    },
    {
      "label": "duplicate-detected",
      "steps": [
        {"click":"[data-testid=ordinary-bend]"},
        {"click":"[data-testid=check-availability]"},
        {"waitFor":"[data-testid=availability-duplicate]"},
        {"eval":"window.scrollTo(0, 0)"}
      ],
      "expect": {"selector":"[data-testid=availability-duplicate]"}
    },
    {
      "label": "too-close",
      "steps": [
        {"click":"[data-testid=swatch-field1-sable]"},
        {"click":"[data-testid=ordinary-bordure]"},
        {"click":"[data-testid=swatch-ordinary-argent]"},
        {"click":"[data-testid=charge-wolf]"},
        {"eval":"(() => { const s = document.querySelector('[data-testid=posture-select]'); if (!s) throw new Error('missing posture-select'); s.value = 'statant'; s.dispatchEvent(new Event('change', { bubbles: true })); })()"},
        {"click":"[data-testid=check-availability]"},
        {"waitFor":"[data-testid=availability-too-close]"},
        {"eval":"window.scrollTo(0, 0)"}
      ],
      "expect": {"selector":"[data-testid=availability-too-close]"}
    },
    {
      "label": "registry-results",
      "steps": [
        {"click":"[data-testid=tab-registry]"},
        {"waitFor":"[data-testid=result-card]"},
        {"eval":"(() => { const s = document.querySelector('[data-testid=filter-ordinary]'); if (!s) throw new Error('missing filter-ordinary'); s.value = 'bordure'; s.dispatchEvent(new Event('change', { bubbles: true })); })()"}
      ],
      "expect": {"state":"populated"}
    },
    {
      "label": "registry-empty",
      "steps": [
        {"click":"[data-testid=tab-registry]"},
        {"waitFor":"[data-testid=result-card]"},
        {"eval":"(() => { const s = document.querySelector('[data-testid=filter-charge]'); if (!s) throw new Error('missing filter-charge'); s.value = 'dragon'; s.dispatchEvent(new Event('change', { bubbles: true })); })()"},
        {"eval":"(() => { const s = document.querySelector('[data-testid=filter-ordinary]'); if (!s) throw new Error('missing filter-ordinary'); s.value = 'bordure'; s.dispatchEvent(new Event('change', { bubbles: true })); })()"}
      ],
      "expect": {"state":"empty"}
    },
    {
      "label": "registry-loading",
      "steps": [
        {"click":"[data-testid=tab-registry]"},
        {"waitFor":"[data-testid=result-card]"},
        {"eval":"(() => { window.__journeyMockFetch = true; window.fetch = () => new Promise(() => {}); })()"},
        {"click":"[data-testid=registry-refresh]"}
      ],
      "expect": {"state":"loading"}
    },
    {
      "label": "registry-error",
      "steps": [
        {"click":"[data-testid=tab-registry]"},
        {"waitFor":"[data-testid=result-card]"},
        {"mockFetch":{"urlPattern":"**/api/arms*","method":"GET","status":500,"body":{"error":"internal_error","message":"The registry had a problem."}}},
        {"click":"[data-testid=registry-refresh]"}
      ],
      "expect": {"state":"error"}
    },
    {
      "label": "entry-detail",
      "steps": [
        {"click":"[data-testid=tab-registry]"},
        {"waitFor":"[data-testid=result-card]"},
        {"click":"[data-testid=result-card]"}
      ],
      "expect": {"selector":"[data-testid=entry-sheet]"}
    },
    {
      "label": "register-success",
      "steps": [
        {"mockFetch":{"urlPattern":"/\\/api\\/arms$/","method":"POST","status":201,"body":{"id":"journey-arms-01","editSecret":"journey-secret-01","registry":{"id":"default","name":"Default"},"rev":1,"blazon":"Azure, a bend Or.","signature":"journey-signature","editLinkEmail":"sent"}}},
        {"click":"[data-testid=ordinary-bend]"},
        {"click":"[data-testid=open-register]"},
        {"fill":"[data-testid=register-name]","value":"House Journey"},
        {"fill":"[data-testid=register-email]","value":"journey@example.com"},
        {"click":"[data-testid=register-submit]"}
      ],
      "expect": {"selector":"[data-testid=register-success]"}
    },
    {
      "label": "register-validation",
      "steps": [
        {"mockFetch":{"urlPattern":"/\\/api\\/arms$/","method":"POST","status":500,"body":{"error":"internal_error","message":"The form should have stopped this request."}}},
        {"click":"[data-testid=ordinary-bend]"},
        {"click":"[data-testid=open-register]"},
        {"fill":"[data-testid=register-name]","value":"House Journey"},
        {"fill":"[data-testid=register-email]","value":"not-an-address"},
        {"fill":"[data-testid=register-discord]","value":"a..b"},
        {"click":"[data-testid=register-submit]"}
      ],
      "expect": {"selector":"[data-testid=register-discord-error]"}
    },
    {
      "label": "recover-request-sent",
      "steps": [
        {"mockFetch":{"urlPattern":"/\\/api\\/recover$/","method":"POST","status":202,"body":{"accepted":true,"message":"If that address owns any arms, we've sent it a link. It works once, for 30 minutes."}}},
        {"click":"[data-testid=header-recover-link]"},
        {"waitFor":"[data-testid=recover-email]"},
        {"fill":"[data-testid=recover-email]","value":"journey@example.com"},
        {"click":"[data-testid=recover-submit]"}
      ],
      "expect": {"selector":"[data-testid=recover-sent]"}
    },
    {
      "label": "recover-redeemed",
      "steps": [
        {"mockFetch":{"urlPattern":"/\\/api\\/recover\\/lookup$/","method":"POST","status":200,"body":{"entry":{"id":"journey-arms-01","registry":{"id":"default","name":"Default"},"displayName":"House Journey","design":{"v":1,"field":{"kind":"plain","tincture":"azure"},"ordinary":{"type":"bend","tincture":"or"},"charges":null},"shape":"heater","blazon":"Azure, a bend Or"},"expiresAt":"2099-01-01T00:00:00Z"}}},
        {"mockFetch":{"urlPattern":"/\\/api\\/recover\\/redeem$/","method":"POST","status":200,"body":{"id":"journey-arms-01","editSecret":"journey-secret-02","registry":{"id":"default","name":"Default"},"displayName":"House Journey","blazon":"Azure, a bend Or","rev":1}}},
        {"eval":"location.hash = '#/recover/journey-token'"},
        {"waitFor":"[data-testid=redeem-new-link]"},
        {"click":"[data-testid=redeem-new-link]"}
      ],
      "expect": {"selector":"[data-testid=redeem-recovered]"}
    },
    {
      "label": "owner-view",
      "steps": [
        {"mockFetch":{"urlPattern":"/\\/api\\/arms\\/journey-arms-01$/","method":"GET","status":200,"body":{"id":"journey-arms-01","registry":{"id":"default","name":"Default"},"displayName":"House Journey","design":{"v":1,"field":{"kind":"plain","tincture":"azure"},"ordinary":{"type":"bend","tincture":"or"},"charges":null},"shape":"heater","blazon":"Azure, a bend Or","contact":{"discord":"house.journey"},"signature":"journey-signature","readability":"bold","rev":1,"createdAt":"2026-10-01T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"}}},
        {"mockFetch":{"urlPattern":"/\\/api\\/arms\\/journey-arms-01\\/owner$/","method":"GET","status":200,"body":{"id":"journey-arms-01","owner":true}}},
        {"eval":"location.hash = '#/a/journey-arms-01/journey-secret-01'"}
      ],
      "expect": {"selector":"[data-testid=owner-edit-link-box]"}
    },
    {
      "label": "owner-link-denied",
      "steps": [
        {"mockFetch":{"urlPattern":"/\\/api\\/arms\\/journey-arms-01$/","method":"GET","status":200,"body":{"id":"journey-arms-01","registry":{"id":"default","name":"Default"},"displayName":"House Journey","design":{"v":1,"field":{"kind":"plain","tincture":"azure"},"ordinary":{"type":"bend","tincture":"or"},"charges":null},"shape":"heater","blazon":"Azure, a bend Or","contact":{"discord":null},"signature":"journey-signature","readability":"bold","rev":1,"createdAt":"2026-10-01T00:00:00Z","updatedAt":"2026-10-01T00:00:00Z"}}},
        {"mockFetch":{"urlPattern":"/\\/api\\/arms\\/journey-arms-01\\/owner$/","method":"GET","status":403,"body":{"error":"forbidden","message":"Wrong edit secret."}}},
        {"eval":"location.hash = '#/a/journey-arms-01/journey-secr'"}
      ],
      "expect": {"selector":"[data-testid=owner-denied]"}
    },
    {
      "label": "compound-layers",
      "steps": [
        {"click":"[data-testid=ordinary-bend]"},
        {"click":"[data-testid=open-register]"},
        {"click":"[data-testid=public-info-button]"}
      ],
      "expect": {"selector":"[data-testid=public-info-popover]"}
    }
  ]
}
