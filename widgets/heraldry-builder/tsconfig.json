{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": []
  },
  "include": ["src", "test/store.test.ts", "test/builder.test.ts", "test/next-shield.test.ts", "test/next-builder.test.ts", "test/next-builder-controls-reach-every-legal-design.test.ts"]
}
